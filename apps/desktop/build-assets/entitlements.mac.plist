<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for the non-Mac-App-Store, notarized build.
  Required for `mac.hardenedRuntime: true` (itself required for
  notarization) — without these, the packaged app either fails to launch
  (Electron's V8 needs the JIT entitlements) or the OS silently denies mic/
  camera access the app already declares intent to use via
  NSMicrophoneUsageDescription etc. in package.json's `mac.extendInfo`.

  Not a sandbox profile — this is a Developer ID (outside-the-App-Store)
  build, so `com.apple.security.app-sandbox` is deliberately absent.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron/V8 need JIT + unsigned executable memory even under the
         hardened runtime, or the app crashes on launch. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Deliberately ABSENT (E-6, 2026-10 security audit), do not add back:
           * com.apple.security.cs.allow-dyld-environment-variables
             lets any same-user process launch this signed app with
             DYLD_INSERT_LIBRARIES and run its own code inside it, inheriting
             the microphone / camera / Screen Recording grants and the
             Keychain item behind safeStorage.
           * com.apple.security.cs.disable-library-validation
             lets the app load a dylib / .node signed by anyone. Not needed:
             the only native module is our own audio_capture.node
             (ScreenCaptureKit), which electron-builder signs with the same
             Developer ID as the app, so it carries the app's Team ID and
             passes library validation. (rnnoise is WASM, not native.)
         scripts/smoke-test.mjs checks that the packaged addon really has the
         app's Team ID; src/utils/electronHardening.test.ts pins this file. -->

    <!-- Matches the NSMicrophoneUsageDescription / NSCameraUsageDescription
         purpose strings already declared in package.json's mac.extendInfo —
         those explain WHY to the user; these grant the OS-level capability. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- WS/HTTPS to the API, LiveKit SFU, MinIO attachments, and the
         auto-updater's MinIO manifest fetch. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
