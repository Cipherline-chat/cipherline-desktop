{
  "name": "desktop",
  "private": true,
  "version": "1.0.20",
  "license": "Apache-2.0",
  "homepage": "https://cipherline.chat",
  "main": "dist-electron/entry.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run dev:electron\"",
    "dev:remote": "vite --host",
    "dev:electron": "wait-on tcp:127.0.0.1:5174 && tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev:second": "tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev:windows": "npm run build -w @cipherline/shared && tsc -p tsconfig.electron.json && npx cross-env VITE_DEV_SERVER_URL=http://cipherline.chat:5174 electron .",
    "dev:packaged": "npm run build && npx electron-builder --dir",
    "dev:vite": "vite --host --port 5174",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "rebuild-native": "npx --package=@electron/rebuild -- electron-rebuild -f -w audio_capture -v 43.2.0",
    "rebuild-native:mac": "bash scripts/rebuild-native-mac.sh",
    "package": "npm run rebuild-native && npm run build && npx electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.cipherline.desktop",
    "productName": "Cipherline",
    "electronVersion": "43.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/test-*.js",
      "build/Release/audio_capture.node"
    ],
    "asarUnpack": [
      "build/Release/audio_capture.node"
    ],
    "extraResources": [
      {
        "from": "build-assets/icon.png",
        "to": "icon.png"
      }
    ],
    "protocols": [
      {
        "name": "Cipherline Invite",
        "schemes": [
          "cipherline"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "build-assets/icon-mac.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cipherline needs microphone access for voice and video calls.",
        "NSCameraUsageDescription": "Cipherline needs camera access for video calls.",
        "NSAudioCaptureUsageDescription": "Cipherline needs system audio access to include sound when you share your screen."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;Chat",
      "icon": "build-assets/icon.png",
      "maintainer": "Cipherline LLC <hello@cipherline.chat>",
      "vendor": "Cipherline LLC",
      "synopsis": "End-to-end encrypted messaging and calls",
      "description": "Cipherline is a private messenger for friends and communities: direct messages, group chats, servers, and voice and video calls, all end-to-end encrypted on your device.",
      "executableName": "cipherline"
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.cipherline.chat",
        "channel": "latest"
      }
    ],
    "npmRebuild": false,
    "deb": {
      "packageName": "cipherline",
      "artifactName": "cipherline_${version}_${arch}.${ext}"
    }
  },
  "dependencies": {
    "@cipherline/shared": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "@noble/curves": "^1.9.7",
    "@noble/ed25519": "^3.0.0",
    "@scure/bip39": "^2.0.1",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^5.10.0",
    "@types/zxcvbn": "^4.4.5",
    "axios": "^1.13.5",
    "dbus-native": "^0.15.1",
    "electron-updater": "^6.8.9",
    "emoji-mart": "^5.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "livekit-client": "^2.17.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.7.1",
    "react-router-dom": "^7.13.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^20.0.3",
    "node-abi": "^4.33.0",
    "node-addon-api": "^8.7.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.2"
  }
}
